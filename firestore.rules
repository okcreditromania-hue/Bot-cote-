rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'okcreditromania@gmail.com'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isValidId(userId) &&
        incoming().fullName is string && incoming().fullName.size() <= 120 &&
        incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isValidId(transactionId);
      allow create: if isValidId(transactionId) &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isValidId(transactionId);
      allow delete: if isAdmin();
    }

    // Support Conversations collection
    match /supportConversations/{conversationId} {
      allow read: if isValidId(conversationId);
      allow create, update: if isValidId(conversationId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isValidId(messageId);
        allow create, update: if isValidId(messageId);
        allow delete: if isAdmin();
      }
    }
  }
}
